{
    "entryFile": "src/app.ts",
    "noImplicitAdditionalProperties": "throw-on-extras",
    "controllerPathGlobs": [
        "src/**/*.controller.ts"
    ],
    "routes": {
        "basePath": "/api",
        "routesDir": "src",
        "authenticationModule": "src/middlewares/auth.middleware.ts"
    },
    "spec": {
        "basePath": "/api",
        "outputDirectory": "src",
        "specVersion": 3,
        "securityDefinitions": {
            "jwt": {
                "type": "apiKey",
                "name": "Authorization",
                "in": "header"
            }
        },
        "tags": [
            {
                "name": "Authentication"
            },
            {
                "name": "Users"
            }
        ]
    }
}