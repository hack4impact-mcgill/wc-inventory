{
    "entryFile": "src/app.ts",
    "noImplicitAdditionalProperties": "throw-on-extras",
    "controllerPathGlobs": [
        "src/**/*.controller.ts"
    ],
    "spec": {
        "basePath": "",
        "outputDirectory": "src",
        "specVersion": 3,
        "securityDefinitions": {
            "jwt": {
                "type": "apiKey",
                "name": "Authorization",
                "in": "header"
            }
        }
    },
    "routes": {
        "routesDir": "src",
        "authenticationModule": "src/middlewares/auth.middleware.ts"
    }
}